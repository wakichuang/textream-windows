<Window x:Class="TextreamWindows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mvvm="clr-namespace:TextreamWindows.App.Mvvm"
        xmlns:overlay="clr-namespace:TextreamWindows.Core.Overlay;assembly=TextreamWindows.Core"
        Title="{Binding WindowTitle}"
        Icon="/Assets/textream-windows.png"
        Width="920" Height="720" MinWidth="720" MinHeight="520"
        FontFamily="Microsoft JhengHei UI" FontSize="14"
        Style="{DynamicResource {x:Type Window}}"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <!--
      第 5.1 步：主視窗與講稿編輯器。外觀預設跟著系統深淺色，也可以固定淺色或深色（ThemeService，2026-10-08 瓦基要求）。
      2026-10-08 參考 ui-ux-pro-max 小幅整理：每個控制項都有看得到的標籤、標籤欄對齊、拉條旁邊直接顯示數值、
      用不到的控制項旁邊講一聲怎麼調（helper text），不加新的分頁或對話框。
    -->
    <Window.Resources>
        <mvvm:EnumEqualsConverter x:Key="EnumEquals" />
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 左邊的標籤欄：同一欄、靠右對齊、次要文字色 -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- 拉條旁邊的數值 -->
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,18,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <!-- 說明文字 -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{Binding SaveAsCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="16">
        <!-- 上方：檔案；右邊是外觀與錄影時隱藏（第 5 階段步驟 5） -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="開啟…" Command="{Binding OpenCommand}" ToolTip="開啟 .md 或 .txt 講稿（Ctrl+O）" />
                <Button Content="儲存" Command="{Binding SaveCommand}" ToolTip="Ctrl+S" />
                <Button Content="另存新檔…" Command="{Binding SaveAsCommand}" ToolTip="Ctrl+Shift+S" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="外觀" Style="{StaticResource Label}" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedValuePath="Value" SelectedValue="{Binding Theme}" DisplayMemberPath="Label"
                          MinWidth="110" Margin="0,0,20,0" ToolTip="預設跟著 Windows 的深淺色；浮層一律深色" />
                <!-- 錄影、分享畫面時浮層看不看得到（瓦基 2026-10-08：原本是勾選框，改成講清楚的兩個選項） -->
                <TextBlock Text="錄影／分享畫面" Style="{StaticResource Label}" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding CaptureOptions}" SelectedValuePath="HideFromCapture" SelectedValue="{Binding HideFromCapture}"
                          DisplayMemberPath="Label" IsEnabled="{Binding IsEditable}" MinWidth="170"
                          ToolTip="看不到：錄影、截圖、Google Meet 分享畫面（含全螢幕）都看不到浮層，只有你自己看得到。&#10;錄得到：浮層跟一般視窗一樣會被錄進去，錄示範影片時用。" />
            </StackPanel>
        </DockPanel>

        <!-- 下方：開始與狀態 -->
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                <Button Content="{Binding StartStopLabel}" Command="{Binding StartStopCommand}" Style="{DynamicResource AccentButtonStyle}"
                        FontSize="16" MinWidth="130" Padding="18,8" Margin="0" HorizontalAlignment="Stretch" />
                <!-- 全域快捷鍵（第 5 階段步驟 4）就寫在開始鍵底下 -->
                <TextBlock Text="Ctrl+Alt+L 開始／暫停" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                <TextBlock Text="Ctrl+Alt+↑↓ 跳一句" Style="{StaticResource Hint}" HorizontalAlignment="Center"
                           ToolTip="在任何程式裡都能按。浮層上點任何一個字就從那裡開始，轉滾輪一格跳一行，Esc 結束。" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat={}{0:0}%}" Width="44" TextAlignment="Right" />
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,0,8,0"
                                 ToolTip="按「開始」會從講稿的這個位置念起（游標的位置）" />
                </DockPanel>
                <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <!-- 起點：游標在哪就從哪開始，停在半路時游標會放在停下的地方（瓦基 2026-10-08） -->
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="從頭開始" Command="{Binding StartFromTopCommand}" Margin="8,0,0,0" Padding="10,2"
                            ToolTip="游標放回講稿最前面，按「開始」就從頭念" />
                    <TextBlock Text="{Binding StartPointText}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </Grid>

        <!-- 設定：左邊一欄標籤，右邊控制項 -->
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 模式 -->
            <TextBlock Grid.Row="0" Text="模式" Style="{StaticResource Label}" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding IsEditable}">
                <RadioButton Content="逐字追蹤" GroupName="Mode" ToolTip="聽你講到哪個字，就跟到哪"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=WordTracking}" />
                <RadioButton Content="定速捲動" GroupName="Mode" ToolTip="照設定的速度一直往前，不聽聲音"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Classic}" />
                <RadioButton Content="有講話才捲" GroupName="Mode" ToolTip="照設定的速度往前，但只在你講話時前進"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=VoiceActivated}" />
            </StackPanel>

            <!-- 浮層樣式；全螢幕才用得到螢幕選單 -->
            <TextBlock Grid.Row="1" Text="浮層" Style="{StaticResource Label}" Margin="0,10,14,0" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding IsEditable}">
                <RadioButton Content="頂端膠囊" GroupName="Overlay" ToolTip="貼在螢幕最上緣正中央，靠近鏡頭，看稿時視線接近看鏡頭"
                             IsChecked="{Binding OverlayStyle, Converter={StaticResource EnumEquals}, ConverterParameter=Capsule}" />
                <RadioButton Content="浮動視窗" GroupName="Overlay" ToolTip="可拖曳、可拉大小，下次會記得位置"
                             IsChecked="{Binding OverlayStyle, Converter={StaticResource EnumEquals}, ConverterParameter=Floating}" />
                <RadioButton Content="全螢幕" GroupName="Overlay" ToolTip="蓋滿選定的螢幕，按 Esc 結束"
                             IsChecked="{Binding OverlayStyle, Converter={StaticResource EnumEquals}, ConverterParameter=FullScreen}" />
                <ComboBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}" DisplayMemberPath="Label"
                          IsEnabled="{Binding IsDisplayChoiceEnabled}" MinWidth="200" Margin="6,0,0,0" ToolTip="全螢幕用哪個螢幕" />
            </StackPanel>

            <!-- 大小：一格一格（瓦基 2026-10-08：寬高同一個間隔，每格 20）；拖浮層邊框則逐點 -->
            <TextBlock Grid.Row="2" Text="大小" Style="{StaticResource Label}" Margin="0,10,14,0" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding IsEditable}">
                <TextBlock Text="寬" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider Value="{Binding CapsuleWidth}" Minimum="{x:Static overlay:OverlayLayout.CapsuleMinWidth}" Maximum="{x:Static overlay:OverlayLayout.CapsuleMaxWidth}"
                        TickFrequency="{x:Static overlay:OverlayLayout.CapsuleWidthStep}" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                        IsEnabled="{Binding IsCapsuleSizeEnabled}" Width="150" VerticalAlignment="Center" ToolTip="頂端膠囊的寬度，每格 20" />
                <TextBlock Text="{Binding CapsuleWidth, StringFormat={}{0:0}}" Style="{StaticResource Value}" Width="34" />
                <TextBlock Text="高" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider Value="{Binding CapsuleHeight}" Minimum="{x:Static overlay:OverlayLayout.CapsuleMinHeight}" Maximum="{x:Static overlay:OverlayLayout.CapsuleMaxHeight}"
                        TickFrequency="{x:Static overlay:OverlayLayout.CapsuleHeightStep}" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                        IsEnabled="{Binding IsCapsuleSizeEnabled}" Width="150" VerticalAlignment="Center" ToolTip="頂端膠囊的高度，每格 20" />
                <TextBlock Text="{Binding CapsuleHeight, StringFormat={}{0:0}}" Style="{StaticResource Value}" Width="34" />
                <TextBlock Text="{Binding SizeHint}" Style="{StaticResource Hint}" />
            </StackPanel>

            <!-- 字級：拉條或直接打數字（瓦基 2026-10-08），三種浮層各記各的 -->
            <TextBlock Grid.Row="3" Text="字級" Style="{StaticResource Label}" Margin="0,10,14,0" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding IsEditable}">
                <Slider Value="{Binding OverlayFontSize}" Minimum="{x:Static overlay:OverlayLayout.MinFontSize}" Maximum="{x:Static overlay:OverlayLayout.MaxFontSize}"
                        TickFrequency="{x:Static overlay:OverlayLayout.FontSizeStep}" IsSnapToTickEnabled="True"
                        Width="190" VerticalAlignment="Center" ToolTip="浮層上講稿的字級（每種浮層各自記住）" />
                <ComboBox x:Name="FontSizeBox" IsEditable="True" ItemsSource="{Binding FontSizeChoices}"
                          Text="{Binding OverlayFontSize, UpdateSourceTrigger=LostFocus}" Width="86" Margin="10,0,6,0"
                          ToolTip="可以直接打數字，按 Enter 套用（14～96）" />
                <TextBlock Text="px" Style="{StaticResource Hint}" Margin="0,0,18,0" />
                <TextBlock Text="套用在目前選的浮層" Style="{StaticResource Hint}" />
            </StackPanel>

            <!-- 麥克風與捲動速度 -->
            <TextBlock Grid.Row="4" Text="麥克風" Style="{StaticResource Label}" Margin="0,10,14,0" />
            <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="捲動速度" Style="{StaticResource Label}" Margin="20,0,10,0" />
                    <Slider Value="{Binding ScrollSpeed}" Minimum="0.5" Maximum="8" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            IsEnabled="{Binding IsSpeedEnabled}" Width="150" VerticalAlignment="Center"
                            ToolTip="定速捲動、有講話才捲時，每秒往前幾個字（逐字追蹤跟著聲音走，用不到）" />
                    <TextBlock Text="{Binding ScrollSpeed, StringFormat=每秒 {0:0.0} 字}" Style="{StaticResource Value}" Margin="8,0,0,0" Width="72" />
                </StackPanel>
                <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Label"
                          IsEnabled="{Binding IsMicrophoneEnabled}" />
            </DockPanel>
        </Grid>

        <!-- 講稿編輯器 -->
        <TextBox x:Name="Editor" Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsRunning}"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontSize="20" Padding="10" />
    </DockPanel>
</Window>
